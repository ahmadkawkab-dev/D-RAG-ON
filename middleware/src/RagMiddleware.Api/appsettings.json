{
  "RagApi": {
    "BaseUrl": "http://localhost:8000",
    "TimeoutSeconds": 900
  },
  "MongoDb": {
    "DatabaseName": "D-RAG-ON"
  },
  "Authentication": {
    "Google": {
      "CallbackPath": "/signin-google"
    },
    "Jwt": {
      "AccessTokenLifetimeMinutes": 15,
      "RefreshTokenLifetimeDays": 30
    }
  },
  "Frontend": {
    "BaseUrl": "http://localhost:5173",
    "OAuthCallbackPath": "/auth/callback",
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://127.0.0.1:5173"
    ]
  },
  "RateLimiting": {
    "AuthPermitLimit": 10,
    "AuthWindowSeconds": 60,
    "OAuthCallbackPermitLimit": 30,
    "RagTokenLimit": 20,
    "RagTokensPerPeriod": 20,
    "RagReplenishmentSeconds": 60,
    "RagConcurrencyLimit": 4,
    "AdminPermitLimit": 60,
    "AdminWindowSeconds": 60
  },
  "RequestLimits": {
    "MaxRequestBodyBytes": 11534336,
    "MaxRequestHeadersBytes": 32768,
    "RequestHeadersTimeoutSeconds": 15,
    "JsonMaxDepth": 32
  },
  "Proxy": {
    "KnownProxies": []
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "localhost"
}
