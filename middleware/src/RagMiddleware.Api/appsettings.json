{
  "RagApi": {
    "BaseUrl": "http://localhost:8000",
    "TimeoutSeconds": 900
  },
  "MongoDb": {
    "DatabaseName": "D-RAG-ON"
  },
  "Authentication": {
    "Google": {
      "CallbackPath": "/signin-google"
    },
    "Jwt": {
      "AccessTokenLifetimeMinutes": 15,
      "RefreshTokenLifetimeDays": 30
    }
  },
  "Frontend": {
    "BaseUrl": "http://localhost:5173",
    "OAuthCallbackPath": "/auth/callback",
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://127.0.0.1:5173"
    ]
  }
}
