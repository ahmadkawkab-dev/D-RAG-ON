import json

from json_review_workspace import (
    canonicalize_record,
    evaluate_imported_record,
    normalize_records_for_evaluation,
    parse_uploaded_records,
    prepare_verified_record,
)


CHUNK = {
    "text": (
        "Maintain an inventory of all accounts managed in the enterprise. "
        "Review and validate all active accounts at least quarterly."
    ),
    "metadata": {"chunk_id": "control05-safeguard5.1"},
}


def _strong_record() -> dict:
    return {
        "query": "How frequently must the enterprise review and validate active accounts?",
        "reference_answer": "The enterprise must review and validate active accounts at least quarterly.",
        "source_text": CHUNK["text"],
        "relevant_chunk_ids": ["control05-safeguard5.1"],
        "verified": False,
        "provenance": "uploaded-json-review",
    }


def test_parse_uploaded_json_array_and_jsonl_errors() -> None:
    array_records, array_errors = parse_uploaded_records(
        json.dumps([{"question": "One?"}, {"query": "Two?"}]).encode(),
        "candidates.json",
    )
    jsonl_records, jsonl_errors = parse_uploaded_records(
        b'{"question":"Valid question?"}\nnot-json\n{"query":"Another?"}\n',
        "candidates.jsonl",
    )

    assert [item["record"]["query"] for item in array_records] == ["One?", "Two?"]
    assert array_errors == []
    assert len(jsonl_records) == 2
    assert "line 2" in jsonl_errors[0]


def test_canonicalize_record_accepts_common_aliases() -> None:
    record = canonicalize_record(
        {
            "prompt": "What is required?",
            "ground_truth": "A quarterly review.",
            "context": ["First paragraph.", "Second paragraph."],
            "chunk_id": "control05-safeguard5.1",
        }
    )

    assert record["query"] == "What is required?"
    assert record["reference_answer"] == "A quarterly review."
    assert record["source_text"] == "First paragraph.\n\nSecond paragraph."
    assert record["relevant_chunk_ids"] == ["control05-safeguard5.1"]


def test_strong_aligned_record_is_ready_and_can_be_prepared() -> None:
    record = _strong_record()
    evaluation = evaluate_imported_record(record, [], [CHUNK])
    prepared = prepare_verified_record(record, evaluation)

    assert evaluation["recommendation"] == "Ready to add"
    assert evaluation["score"] >= 85
    assert evaluation["matched_chunk_id"] == "control05-safeguard5.1"
    assert prepared["verified"] is True
    assert prepared["relevant_chunk_ids"] == ["control05-safeguard5.1"]
    assert prepared["provenance"] == "human-reviewed-json-upload"


def test_duplicate_or_unsupported_record_is_not_added() -> None:
    record = _strong_record()
    duplicate = evaluate_imported_record(record, [record], [CHUNK])
    unsupported = evaluate_imported_record(
        {
            **record,
            "query": "What unrelated claim should this new candidate assert today?",
            "reference_answer": "The moon is made of cheese.",
        },
        [],
        [CHUNK],
    )

    assert duplicate["recommendation"] == "Do not add"
    assert duplicate["duplicate"] is True
    assert unsupported["recommendation"] == "Do not add"
    assert unsupported["blockers"]


def test_evaluate_json_workspace_starts_without_frontend_exceptions() -> None:
    from pathlib import Path

    from streamlit.testing.v1 import AppTest

    app_path = Path(__file__).resolve().parents[1] / "app.py"
    app = AppTest.from_file(str(app_path), default_timeout=30)
    app.session_state["main_navigation"] = "Evaluate"
    app.session_state["evaluation_workflow"] = "Review JSON candidates"
    app.run()

    assert not app.exception


def test_system_dock_is_in_main_content_not_sidebar() -> None:
    from pathlib import Path

    from streamlit.testing.v1 import AppTest

    app_path = Path(__file__).resolve().parents[1] / "app.py"
    app = AppTest.from_file(str(app_path), default_timeout=30)
    app.run()

    assert not app.exception
    assert any("system-dock" in item.value for item in app.main.markdown)
    assert not any("system-dock" in item.value for item in app.sidebar.markdown)
    assert any("RAG<span>//</span>STUDIO" in item.value for item in app.main.markdown)


def test_loose_pretty_printed_object_sequence_is_recovered() -> None:
    payload = b"""
    {
      "name": "First",
      "input": "What must the inventory contain and how often is it reviewed?",
      "expected_output": "It contains managed assets and is reviewed bi-annually.",
      "context": ["Inventory text reviewed bi-annually."]
    },
    {
      "name": "Second",
      "input": "How often should DHCP logs update the inventory?",
      "expected_output": "Weekly or more frequently.",
      "context": ["Review DHCP logs weekly or more frequently."]
    },
    """

    records, errors = parse_uploaded_records(payload, "shared-dataset.jsonl")

    assert errors == []
    assert len(records) == 2
    assert records[0]["record"]["query"].startswith("What must")
    assert records[0]["record"]["reference_answer"].startswith("It contains")
    assert records[0]["record"]["source_text"] == "Inventory text reviewed bi-annually."


def test_nested_unknown_wrapper_and_chat_records_are_inferred() -> None:
    nested = {
        "export": {
            "batch": [
                {
                    "fields": {
                        "user_query": "What is the first requirement here?",
                        "ideal_answer": "The first supported answer.",
                        "evidence": [{"text": "The first supported answer."}],
                    }
                },
                {
                    "messages": [
                        {"role": "user", "content": "What is the second requirement here?"},
                        {"role": "assistant", "content": "The second supported answer."},
                    ],
                    "documents": [{"page_content": "The second supported answer."}],
                },
            ]
        }
    }

    records, errors = parse_uploaded_records(
        json.dumps(nested).encode(),
        "arbitrary-export.json",
    )

    assert errors == []
    assert len(records) == 2
    assert records[0]["record"]["query"] == "What is the first requirement here?"
    assert records[0]["record"]["source_text"] == "The first supported answer."
    assert records[1]["record"]["query"] == "What is the second requirement here?"
    assert records[1]["record"]["reference_answer"] == "The second supported answer."
    assert records[1]["record"]["source_text"] == "The second supported answer."

